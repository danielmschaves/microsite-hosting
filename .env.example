# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. All external services are
# configured here so the same image runs against MinIO/Postgres (local) or
# AWS S3/Neon (prod) with no code changes.
# ---------------------------------------------------------------------------

# --- Auth.js ---------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-random-string
# Required behind Docker / non-Vercel hosts so Auth.js trusts the request host.
AUTH_TRUST_HOST=true

# Dev-only email login: sign in as any email without configuring OAuth apps.
# Great for local testing (including the viewer allowlist). NEVER set true in
# production — it authenticates anyone who types an email.
AUTH_DEV_LOGIN=true

# OAuth apps — create at:
#   Google: https://console.cloud.google.com/apis/credentials
#   GitHub: https://github.com/settings/developers
# Callback URLs:
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/github
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Database (Postgres) ---------------------------------------------------
# Local docker-compose value shown; swap for a Neon connection string in prod.
DATABASE_URL=postgres://shipsite:shipsite@localhost:5432/shipsite

# --- Storage (S3-compatible) ----------------------------------------------
# Leave S3_ENDPOINT blank to use real AWS S3. Set it (and path-style is forced)
# to target MinIO or another S3-compatible store.
S3_ENDPOINT=http://localhost:9000
# Endpoint embedded in presigned browser-upload URLs (must be reachable from
# the user's browser). Leave blank to reuse S3_ENDPOINT / AWS default.
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=shipsite
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# --- App -------------------------------------------------------------------
# Public base URL used to build shareable links.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Cron cleanup ----------------------------------------------------------
# Bearer token required to call POST /api/cleanup. Vercel Cron sends this
# automatically when configured; for local use, curl with -H "Authorization: Bearer <value>".
CRON_SECRET=replace-me-with-a-random-string

# Extra server-side body cap for the multipart upload route (bytes).
MAX_UPLOAD_BYTES=262144000

# --- Email (Resend) — optional; invites fall back to copy-links -------------
# https://resend.com — EMAIL_FROM must be a verified sender/domain.
RESEND_API_KEY=
EMAIL_FROM=

# --- Billing (Stripe) — optional; absent = everything is free tier ----------
# STRIPE_TEAM_PRICE_ID = a recurring per-seat price (~$5/user/mo).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEAM_PRICE_ID=

# Dev only: treat every workspace as Team plan without Stripe (blocked in prod).
PLAN_FAKE_TEAM=false
